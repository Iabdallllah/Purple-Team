# Purple Platform - Environment Variables
# Copy this file to .env and fill in the values

# ===========================================
# Application
# ===========================================
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
API_PREFIX=/api/v1

# ===========================================
# Database (PostgreSQL with pgvector)
# ===========================================
POSTGRES_PASSWORD=purple
DATABASE_URL=postgresql+asyncpg://purple:purple@localhost:5432/purple
DATABASE_URL_SYNC=postgresql://purple:purple@localhost:5432/purple

# ===========================================
# Redis
# ===========================================
REDIS_URL=redis://localhost:6379/0
REDIS_STREAMS_MAXLEN=10000

# ===========================================
# ChromaDB (Vector Database)
# ===========================================
CHROMADB_URL=http://localhost:8000
CHROMADB_COLLECTION=purple-episodes

# ===========================================
# Ollama (Local LLM)
# ===========================================
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ===========================================
# JWT Authentication
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================================
# Neo4j (Optional - Phase 2)
# ===========================================
# NEO4J_PASSWORD=password
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j

# ===========================================
# Sandbox / Docker
# ===========================================
DOCKER_HOST=unix:///var/run/docker.sock
SANDBOX_NETWORK=purple-network
SANDBOX_DEFAULT_TIMEOUT=300
SANDBOX_MAX_CONTAINERS=10
SANDBOX_CPU_LIMIT=2
SANDBOX_MEMORY_LIMIT=4g

# ===========================================
# Target Applications
# ===========================================
JUICE_SHOP_URL=http://localhost:3001
DVWA_URL=http://localhost:3002

# ===========================================
# Monitoring (Phase 5)
# ===========================================
# PROMETHEUS_URL=http://localhost:9090
# GRAFANA_URL=http://localhost:3000
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ===========================================
# External LLM (Optional - Fallback)
# ===========================================
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# ===========================================
# Email (Optional - Notifications)
# ===========================================
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=noreply@purple-platform.com

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=DEBUG
LOG_FORMAT=json