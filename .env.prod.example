# Purple Platform Production Environment
# Copy to .env and set strong secrets before deploy

# Postgres
POSTGRES_DB=purple
POSTGRES_USER=purple
POSTGRES_PASSWORD=purple_prod_ChangeMe_Strong!Example123

# Redis
REDIS_PASSWORD=

# JWT - MUST be 32+ chars, rotate in prod
JWT_SECRET=change-me-32-chars-minimum-prod-secret-please-rotate

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=purple_grafana_ChangeMe!

# Ollama
OLLAMA_MODEL=llama3.1:8b

# Public URLs (for web -> api)
NEXT_PUBLIC_API_URL=http://localhost:8001
# For production behind reverse proxy:
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# Optional LLM fallbacks
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# Monitoring
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# SLACK_WEBHOOK_URL=
# PAGERDUTY_KEY=
